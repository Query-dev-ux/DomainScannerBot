# ── Telegram ──────────────────────────────────────────────
BOT_TOKEN=123456:ABC-your-bot-token
# Chat/group where alerts are posted. For a supergroup with topics add ALERT_THREAD_ID.
ALERT_CHAT_ID=-1001234567890
ALERT_THREAD_ID=
# Comma-separated Telegram user IDs allowed to run bot commands.
ADMIN_IDS=11111111,22222222

# ── Domain sources ───────────────────────────────────────
# Each source is enabled when its credentials are filled in; you need at least one.
# Every domain a source returns is checked. Syncs are independent: a source only
# drops its own domains when they disappear from it.

# PWApartners Open API
PWA_API_BASE_URL=https://openapi.pwa.partners/api
PWA_API_KEY=
PWA_TEAM_UUID=
PWA_TEAMATE_UUID=

# SkakApp API — docs: https://uclient.skakapp.com/api-docs/
# HTTP Basic auth with your SkakApp account login and password.
# SkakApp also issues an API key — this API doesn't use it, no need to set it.
# (The old UCLIENT_LOGIN / UCLIENT_PASSWORD names are still accepted.)
SKAKAPP_API_BASE_URL=https://uclient.skakapp.com/api
SKAKAPP_LOGIN=
SKAKAPP_PASSWORD=

# ── Reputation checkers ──────────────────────────────────
# Google Safe Browsing v4 API key (https://developers.google.com/safe-browsing)
GSB_API_KEY=
# Facebook app credentials — used to check whether FB blocks links to the domain.
# Create an app at https://developers.facebook.com/apps (type "Other"/"Business"),
# then take App ID / App Secret from Settings → Basic. Both are required.
FB_APP_ID=
FB_APP_SECRET=

# ── Database ─────────────────────────────────────────────
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=domain_scanner
POSTGRES_USER=domain_scanner
POSTGRES_PASSWORD=change-me

# ── Scheduler (автоматический режим) ─────────────────────
# How often to pull domains from the PWA API (minutes)
SYNC_INTERVAL_MINUTES=60
# How often each domain is re-checked (minutes). The scan job itself wakes up
# three times as often and picks whatever has become due.
SCAN_INTERVAL_MINUTES=180
# Max concurrent domain checks
SCAN_CONCURRENCY=5
# Max domains handled by one scheduled scan run — keeps a large backlog from
# bursting into external API rate limits. It drains over the following runs.
SCAN_BATCH_SIZE=50

# ── Misc ─────────────────────────────────────────────────
# Timezone for times shown in Telegram messages (IANA name, e.g. Europe/Moscow)
DISPLAY_TIMEZONE=UTC
LOG_LEVEL=INFO
